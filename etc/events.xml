<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="sales_order_save_after">
        <observer name="ahmed_erp_sync_create_order_item"
                  instance="Ahmed\ErpSyncMonitor\Observer\CreateOrderSyncItem"/>
    </event>
    <event name="sales_order_save_commit_after">
        <observer name="ahmed_erp_sync_publish_order_item"
                  instance="Ahmed\ErpSyncMonitor\Observer\PublishOrderSyncItem"/>
    </event>
</config>
